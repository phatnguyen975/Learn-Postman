                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                      },
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "url": "{{baseUrl}}/api/admin/coupons",
                    "body": {
                      "mode": "raw",
                      "raw": "{\"code\": \"NOMAX01\", \"type\": \"percent\", \"discount_value\": 10, \"min_order_amount\": 0, \"expired_at\": \"2027-12-31\"}"
                    }
                  },
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                          "if (pm.response.code === 200) {",
                          "    pm.environment.set('fr003_id', pm.response.json().id);",
                          "}"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "TC-FR17-FR-003 — Step 2: Verify max_uses_per_user defaults to 1 & teardown",
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/coupons",
                      "host": ["{{baseUrl}}"],
                      "path": ["api", "coupons"]
                    }
                  },
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                          "if (pm.response.code === 200) {",
                          "    let list = pm.response.json();",
                          "    let found = list.find(c => c.id === pm.environment.get('fr003_id'));",
                          "    pm.test('Coupon found', function() { pm.expect(found).to.not.be.undefined; });",
                          "    if (found) {",
                          "        pm.test('max_uses_per_user is 1', function() { pm.expect(found.max_uses_per_user).to.eql(1); });",
                          "    }",
                          "    let req = { url: pm.environment.get('baseUrl') + '/api/admin/coupons/' + pm.environment.get('fr003_id'), method: 'DELETE', header: { 'Authorization': 'Bearer ' + pm.environment.get('adminToken') } };",
                          "    pm.sendRequest(req, function(){});",
                          "    pm.environment.unset('fr003_id');",
                          "}"
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
