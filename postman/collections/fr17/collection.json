                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/admin/coupons",
                "body": {
                  "mode": "raw",
                  "raw": "{\"code\": \"SCH200A\", \"type\": \"percent\", \"discount_value\": 10, \"min_order_amount\": 0, \"expired_at\": \"2027-12-31\"}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                      "pm.test('Schema matches', function() { pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"message\", \"id\"], \"properties\": {\"message\": {\"type\": \"string\", \"enum\": [\"Coupon created\"]}, \"id\": {\"type\": \"integer\"}}, \"additionalProperties\": false}); });",
                      "",
                      "if (pm.response.code === 200) {",
                      "    let jsonData = pm.response.json();",
                      "    if (jsonData && jsonData.id) {",
                      "        let req = {",
                      "            url: pm.environment.get(\"baseUrl\") + \"/api/admin/coupons/\" + jsonData.id,",
                      "            method: 'DELETE',",
                      "            header: {",
