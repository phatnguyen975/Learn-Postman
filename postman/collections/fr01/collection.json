{
  "info": {
    "name": "FR01 — POST /api/register",
    "schema": "https://schema.postman.com/collection/json/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({",
          "    key: 'X-Student-Id',",
          "    value: pm.environment.get('studentId') || '23127449'",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[Control] Iteration Router",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/get",
          "protocol": "https",
          "host": ["postman-echo", "com"],
          "path": ["get"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration > 0) {",
              "    postman.setNextRequest('Data-Driven Template');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Static TCs",
      "item": [
        {
          "name": "TC-SEC",
          "item": [
            {
              "name": "TC-FR01-SEC-001 — Verify response body does not expose password field",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"SecTest\",\n  \"email\": \"sectest2@domain.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-001 — Verify response body does not expose password field — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-001 — Verify response body does not expose password field — Response does not have password\", function () {",
                      "    pm.expect(pm.response.json()).to.not.have.property(\"password\");",
                      "    const body = pm.response.json();",
                      "    pm.expect(body).to.have.property(\"message\");",
                      "    pm.expect(body).to.have.property(\"id\");",
                      "    pm.expect(body.id).to.be.a(\"number\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SEC-003 — Verify SQL injection in name field is blocked",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"'; SELECT * FROM users;--\",\n  \"email\": \"sqli2@domain.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-003 — Verify SQL injection in name field is blocked — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-003 — Verify SQL injection in name field is blocked — Response has message and id\", function () {",
                      "    pm.expect(pm.response.json()).to.have.property(\"message\");",
                      "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SEC-005 — Verify Content-Type header is application/json",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SEC-005 — Verify Content-Type header is application/json — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"TC-FR01-SEC-005 — Verify Content-Type header is application/json — Response has correct Content-Type header\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "    const body = pm.response.json();",
                      "    pm.expect(body).to.have.property(\"message\");",
                      "    pm.expect(body).to.have.property(\"id\");",
                      "    pm.expect(body.id).to.be.a(\"number\");",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "TC-SCH",
          "item": [
            {
              "name": "TC-FR01-SCH-001 — Verify success response has required message field",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user-1@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SCH-001 — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var schema = {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"id\": {\"type\": \"integer\"}}, \"required\": [\"message\", \"id\"], \"additionalProperties\": false};",
                      "pm.test(\"TC-FR01-SCH-001 — Schema is valid\", function () {",
                      "    pm.response.to.have.jsonSchema(schema);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SCH-002 — Verify success response has required id field",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user-2@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SCH-002 — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var schema = {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"id\": {\"type\": \"integer\"}}, \"required\": [\"message\", \"id\"], \"additionalProperties\": false};",
                      "pm.test(\"TC-FR01-SCH-002 — Schema is valid\", function () {",
                      "    pm.response.to.have.jsonSchema(schema);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SCH-003 — Verify success response has no extra fields",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user-3@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SCH-003 — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var schema = {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"id\": {\"type\": \"integer\"}}, \"required\": [\"message\", \"id\"], \"additionalProperties\": false};",
                      "pm.test(\"TC-FR01-SCH-003 — Schema is valid\", function () {",
                      "    pm.response.to.have.jsonSchema(schema);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-FR01-SCH-004 — Verify success response Content-Type header",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user-4@eshop.com\",\n  \"password\": \"Password123!\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"TC-FR01-SCH-004 — Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var schema = {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"id\": {\"type\": \"integer\"}}, \"required\": [\"message\", \"id\"], \"additionalProperties\": false};",
                      "pm.test(\"TC-FR01-SCH-004 — Schema is valid\", function () {",
                      "    pm.response.to.have.jsonSchema(schema);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Data-Driven TCs",
      "item": [
        {
          "name": "Data-Driven Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tc_id = pm.iterationData.get('tc_id');",
                  "const expectedStatus = parseInt(pm.iterationData.get('expected_status'), 10);",
                  "const expectedMessage = pm.iterationData.get('expected_message');",
                  "",
                  "pm.test(tc_id + ' — Status matches expected (' + expectedStatus + ')', function () {",
                  "    pm.response.to.have.status(expectedStatus);",
                  "});",
                  "",
                  "if (expectedMessage) {",
                  "    pm.test(tc_id + ' — Response message matches', function () {",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.message || body.error).to.include(expectedMessage);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
